{
  "name": "dsiab",
  "private": false,
  "type": "module",
  "version": "0.9.0",
  "description": "dsiab, Design System In A Box: a brand-themeable component and token layer over Radix Themes.",
  "license": "(MIT AND OFL-1.1)",
  "author": "cakemunny",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cakemunny/dsiab.git"
  },
  "bugs": {
    "url": "https://github.com/cakemunny/dsiab/issues"
  },
  "homepage": "https://dsiab.pages.dev",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./registry.json": "./dist/registry.json",
    "./DECISIONS.md": "./dist/DECISIONS.md",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dsiab": "bin/dsiab.mjs",
    "ds-check": "bin/ds-check.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES",
    "CHANGELOG.md",
    "docs/GUIDELINES.md",
    "docs/AGENT-SETUP.md",
    "docs/REFERENCES.md",
    "src/foundations/consumerRules.mjs",
    "skills/dsiab",
    "skills/design-system-steward",
    "bin/dsiab.mjs",
    "bin/docs-url.mjs",
    "bin/dsiab-init.mjs",
    "bin/ds-check.mjs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "keywords": [
    "design-system",
    "radix-themes",
    "radix-ui",
    "react",
    "components",
    "design-tokens",
    "themeable",
    "accessibility",
    "wcag"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && vite build --config vite.config.lib.ts && tsc -p tsconfig.build.json && node scripts/dist-types.mjs && node scripts/dist-registry.mjs && node scripts/dist-decisions.mjs",
    "postbuild": "node scripts/scan-public-build.mjs dist",
    "dev": "vite build --config vite.config.lib.ts --watch",
    "dev:types": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "pack": "npm run build && npm pack",
    "prepublishOnly": "npm run build",
    "barrel": "node scripts/gen-barrel.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "postbuild-storybook": "node scripts/scan-public-build.mjs storybook-static",
    "docs": "node bin/dsiab.mjs docs",
    "agents": "node scripts/agents.mjs",
    "pretest": "npm run test:tokens",
    "test": "vitest",
    "test:tokens": "vitest run --config vitest.node.config.ts",
    "test:publish": "node scripts/acceptance.mjs",
    "changelog": "node scripts/gen-changelog.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "install-git-hooks": "node scripts/install-git-hooks.mjs"
  },
  "peerDependencies": {
    "@radix-ui/themes": "~3.3.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@radix-ui/themes": "~3.3.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@types/apca-w3": "^0.1.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "apca-w3": "^0.1.9",
    "playwright": "^1.61.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.4.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-toolbar": "^1.1.13",
    "radix-ui": "^1.1.3"
  }
}
