# Make `engines.node` in package.json a HARD requirement, not a suggestion.
#
# npm treats a root package's `engines` field as advisory by default: on an unsupported Node it
# installs anyway, prints nothing, and exits 0 — the failure surfaces much later as an unrelated
# syntax or API error deep in a build. `engine-strict=true` turns that silence into an EBADENGINE
# error at install time, naming the required range and the version actually running.
#
# This file is part of the delivered package (the zip is cut with `git archive`, so a committed
# dotfile ships), and npm reads it from the project root before installing. It does NOT propagate
# to a consumer's own project — .npmrc is per-project, and npm never publishes it in a tarball —
# so it protects whoever installs THIS package's own dependencies, which is the case that was
# silent. Consumers who want the same guarantee in their app set it in their own .npmrc.
engine-strict=true
